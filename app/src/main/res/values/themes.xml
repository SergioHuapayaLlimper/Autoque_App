<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Autoque" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/autoque_black</item>
        <item name="colorOnPrimary">@color/autoque_white</item>
        <item name="colorPrimaryContainer">@color/autoque_yellow</item>
        <item name="colorOnPrimaryContainer">@color/autoque_black</item>
        <item name="colorSecondary">@color/autoque_yellow</item>
        <item name="colorOnSecondary">@color/autoque_black</item>
        <item name="colorSecondaryContainer">@color/autoque_yellow_soft</item>
        <item name="colorOnSecondaryContainer">@color/autoque_black</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorSurfaceContainerLowest">@color/surface_card</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card</item>
        <item name="colorSurfaceContainerHighest">@color/surface_muted</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Autoque.Dialog</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="textInputStyle">@style/Widget.Autoque.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Autoque.Button</item>
        <item name="toolbarStyle">@style/Widget.Autoque.Toolbar</item>
    </style>

    <style name="Theme.Autoque" parent="Base.Theme.Autoque" />

    <style name="Theme.Autoque.Welcome" parent="Theme.Autoque">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Autoque.Splash" parent="Theme.Autoque.Welcome">
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/black</item>
    </style>

    <style name="ThemeOverlay.Autoque.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSecondary">@color/autoque_black</item>
        <item name="colorPrimary">@color/autoque_black</item>
    </style>

    <style name="Widget.Autoque.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Autoque.Medium</item>
    </style>

    <style name="Widget.Autoque.Button.Dark">
        <item name="backgroundTint">@color/button_dark_bg</item>
        <item name="android:textColor">@color/button_dark_text</item>
    </style>

    <style name="Widget.Autoque.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/autoque_black</item>
        <item name="strokeColor">@color/autoque_black</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Autoque.Medium</item>
    </style>

    <style name="Widget.Autoque.Button.Small" parent="Widget.Autoque.Button.Dark">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.Autoque.Button.Outlined.Small">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.Autoque.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/autoque_black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Autoque.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Autoque.Logo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Widget.Autoque.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/autoque_black</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Autoque.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/autoque_black</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Autoque.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_card</item>
        <item name="titleTextAppearance">@style/TextAppearance.Autoque.ToolbarTitle</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="Widget.Autoque.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconTint">@color/autoque_yellow</item>
        <item name="chipMinHeight">44dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Autoque.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="strokeColor">@color/autoque_black</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Autoque.RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/autoque_yellow</item>
        <item name="android:secondaryProgressTint">@color/autoque_yellow</item>
        <item name="android:progressBackgroundTint">@color/outline</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">1</item>
    </style>

    <style name="Autoque.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/autoque_yellow</item>
    </style>

    <style name="TextAppearance.Autoque.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Autoque.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Autoque.Step" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Autoque.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Autoque.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Autoque.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Autoque.Helper" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Autoque.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Autoque.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Autoque.Label</item>
    </style>

    <style name="Autoque.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Autoque.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
